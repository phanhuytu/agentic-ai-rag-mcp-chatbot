# Demo auth (optional). If set, all /api/* require: Authorization: Bearer <token>
API_ACCESS_TOKEN=

# Server
PORT=3000
# Local: http://localhost:4200 | Vercel: leave empty/* or set your production URL
CORS_ORIGIN=http://localhost:4200

# LLM provider: gemini | openai
LLM_PROVIDER=gemini

# Google Gemini (get a key at https://aistudio.google.com/apikey — never commit real keys)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# RAG: embedding | keyword  (on Vercel, defaults to keyword if unset)
RAG_MODE=
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
