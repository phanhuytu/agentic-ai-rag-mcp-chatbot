{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "frontend/dist/frontend/browser",
  "installCommand": "npm install && npm run install:all",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{backend/data/**,backend/dist/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
